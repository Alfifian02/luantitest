+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "gamepadnav.h"
+
+#include <cfloat>
+#include <cstdlib>
+#include <cmath>
+#include <algorithm>
+
+#include <ICursorControl.h>
+#include <IGUIElement.h>
+#include <IGUIEnvironment.h>
+#include <IGUIListBox.h>
+#include <IVideoDriver.h>
+#include <IrrlichtDevice.h>
