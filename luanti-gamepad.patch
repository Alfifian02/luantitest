+gamepad_response_curve (Stick response curve) float 1.5 0.5 4
+
+#    How far a trigger has to be pulled before it counts as pressed.
+gamepad_trigger_threshold (Trigger threshold) float 0.15 0 0.95
+
+#    Invert the vertical axis of the right stick when looking around.
+gamepad_invert_look_y (Invert vertical look) bool false
+
+#    Vertical look speed relative to horizontal look speed.
+#    Values below 1 make looking up and down slower.
+gamepad_look_vertical_ratio (Vertical look speed ratio) float 1.0 0.1 4
+
+#    Vibrate the gamepad, for example when taking damage.
+gamepad_rumble (Gamepad vibration) bool true
+
+gamepad_rumble_strength (Gamepad vibration strength) float 0.7 0 1
+
+#    Allow menus and formspecs to be controlled with a gamepad.
